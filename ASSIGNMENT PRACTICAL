<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Coding Timetable</title>
<style>
    body {
        font-family: Arial, sans-serif;
        padding: 40px;
    }
    h1 {
        text-align: center;
    }
    table {
        width: 100%;
        border-collapse: collapse;
    }
    th, td {
        border: 1px solid #000;
        padding: 12px 10px;
        text-align: center;
        font-size: 14px;
    }
    audio {
        display: block;
        margin: 20px auto;
    }
</style>
</head>
<body>

<h1>Weekly Coding Timetable</h1>

<audio controls>
    <source src="your-audio-file.mp3" type="audio/mpeg">
    Your browser does not support the audio element.
</audio>

<table>
    <tr>
        <th>Time</th>
        <th>Monday</th>
        <th>Tuesday</th>
        <th>Wednesday</th>
        <th>Thursday</th>
        <th>Friday</th>
    </tr>
    <tr>
        <td>9:00 - 10:00</td>
        <td>Python</td>
        <td>Java</td>
        <td>C++</td>
        <td>Python</td>
        <td>Java</td>
    </tr>
    <tr>
        <td>10:00 - 11:00</td>
        <td>Java</td>
        <td>C++</td>
        <td>JavaScript</td>
        <td>C++</td>
        <td>Python</td>
    </tr>
    <tr>
        <td>11:00 - 11:15</td>
        <td colspan="5">Break</td>
    </tr>
    <tr>
        <td>11:15 - 12:15</td>
        <td>JavaScript</td>
        <td>HTML/CSS</td>
        <td>SQL</td>
        <td>JavaScript</td>
        <td>HTML/CSS</td>
    </tr>
    <tr>
        <td>12:15 - 1:15</td>
        <td>HTML/CSS</td>
        <td>Python</td>
        <td>Java</td>
        <td>SQL</td>
        <td>C++</td>
    </tr>
    <tr>
        <td>1:15 - 2:15</td>
        <td>SQL</td>
        <td>JavaScript</td>
        <td>HTML/CSS</td>
        <td>Java</td>
        <td>SQL</td>
    </tr>
</table>

</body>
</html>